# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=replace-me

# Zeitzone des Bots. Alle Termine, Tagesgrenzen und Auswertungen rechnen damit.
# Im Container ist die Systemzeit meist UTC – ohne diesen Wert wären Meetings,
# Wochenberichte und Abmeldungen ein bis zwei Stunden verschoben.
# Bewusst eine Zeitzone statt eines festen Versatzes: Europe/Berlin deckt MEZ
# (+1) und MESZ (+2) samt Umstellungsterminen ab.
BOT_TIMEZONE=Europe/Berlin

# Für das Web-Dashboard (Discord Developer Portal → OAuth2).
# Als Redirect-URL dort eintragen: <WEB_BASE_URL>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Nur für das Modul „Teamliste“: zum Auflisten aller Servermitglieder braucht
# Discord das privilegierte Server-Members-Intent. Vor dem Umstellen auf true
# muss es im Developer Portal unter Bot → Privileged Gateway Intents
# freigeschaltet sein, sonst verweigert Discord die Anmeldung.
GUILD_MEMBERS_INTENT=false

# --- Web-Dashboard ---------------------------------------------------------
WEB_ENABLED=true
WEB_PORT=8080
WEB_HOST=0.0.0.0
# Öffentlich erreichbare Adresse (ohne Slash am Ende). Hinter einem Reverse
# Proxy die externe HTTPS-Adresse eintragen.
WEB_BASE_URL=http://localhost:8080

# --- Content-Creator-Benachrichtigungen ------------------------------------
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
CREATOR_POLL_INTERVAL_SECONDS=180

# --- Sprach-Transkripte (lokal via whisper.cpp) ----------------------------
# Beide Pfade gesetzt = Feature aktiv. Aufnahme startet nur nach Zustimmung
# aller Teilnehmer.
WHISPER_BINARY_PATH=
WHISPER_MODEL_PATH=
# Optional: Ordner mit den .so-Bibliotheken. Leer = Ordner der Binary.
WHISPER_LIB_DIR=
WHISPER_THREADS=2
WHISPER_LANGUAGE=de

# --- Support-Startwerte ----------------------------------------------------
# Nur für das erstmalige Anlegen von Channels/Rollen. Die laufende
# Konfiguration erfolgt danach im Dashboard.
SUPPORT_WAITING_CHANNEL_NAME=support-warteraum
SUPPORT_MANAGEMENT_CHANNEL_NAME=support-verwaltung
SUPPORT_TALK_CATEGORY_NAME=Support Talk
SUPPORT_TICKET_CATEGORY_NAME=Support Tickets
SUPPORT_TALK_CHANNEL_PREFIX=support-talk
SUPPORT_TALK_CHANNEL_COUNT=3
SUPPORT_DEFAULT_DEPARTMENT_NAME=Support
SUPPORT_DEFAULT_DEPARTMENT_ROLE_IDS=

VERIFY_DEFAULT_ROLE_NAME=Verifiziert
VERIFY_DEFAULT_CHANNEL_NAME=verify

# --- GitHub-Updates --------------------------------------------------------
GITHUB_TOKEN=
UPDATES_POLL_INTERVAL_MINUTES=15

# --- Sonstiges -------------------------------------------------------------
LOG_LEVEL=info
# Optional: eigenes Datenverzeichnis (Standard: <projekt>/data)
# DATA_DIR=/pfad/zu/daten
